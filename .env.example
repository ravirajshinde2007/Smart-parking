# ParkSmart - Environment Configuration

# Server & Security
PORT=5000
NODE_ENV=production
JWT_SECRET=change_this_to_a_long_random_secret
CLIENT_ORIGIN=*

# Cloud MySQL Database Configuration (e.g. TiDB Cloud, Aiven, Railway, AWS RDS, PlanetScale)
DB_HOST=your-db-host.com
DB_PORT=3306
DB_NAME=parksmart
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SSL=true

# Storage & Uploads (/tmp/uploads is recommended for Vercel Serverless)
UPLOAD_DIR=/tmp/uploads
MAX_UPLOAD_MB=8
OCR_LANGUAGE=eng
ALLOW_MANUAL_PLATE=false

# Admin Account Credentials
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=raviraj@2007
